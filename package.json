{
  "name": "react-native-virtual-list",
  "version": "0.1.0",
  "description": "Virtualized list for React Native and react-native-web that keeps its scroll position when item heights are only known after they render",
  "keywords": [
    "react-native",
    "react-native-web",
    "virtual-list",
    "virtualization",
    "windowing",
    "chat",
    "infinite-scroll",
    "scroll-anchoring",
    "flatlist"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-native": ">=0.70"
  },
  "scripts": {
    "test": "node --test tests/*.test.js && jest",
    "test:unit": "node --test tests/*.test.js",
    "test:render": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theRizwan/react-native-virtual-list.git"
  },
  "bugs": {
    "url": "https://github.com/theRizwan/react-native-virtual-list/issues"
  },
  "homepage": "https://github.com/theRizwan/react-native-virtual-list#readme",
  "devDependencies": {
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "react": "^18.3.1",
    "react-native": "^0.76.5",
    "react-test-renderer": "^18.3.1"
  }
}
